<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Pets</h1>
  <%= link_to 'Register New Pet', new_pet_path, class: "btn btn-primary" %>
</div>

<table class="table table-hover">
  <thead class="table-dark">
    <tr>
      <th>Name</th>
      <th>Species</th>
      <th>Owner</th>
      <th class="text-center">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @pets.each do |pet| %>
      <tr>
        <td class="fw-bold"><%= pet.name %></td>
        <td><%= pet.species %></td>
        <td><%= pet.owner.last_name %></td>
        <td class="text-center">
          <div class="d-flex justify-content-center gap-2">
            <%= link_to 'Show', pet, class: "btn btn-sm btn-info" %>
            <%= link_to 'Edit', edit_pet_path(pet), class: "btn btn-sm btn-warning" %>
            <%= button_to 'Delete', pet, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>