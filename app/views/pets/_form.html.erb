<%= form_with(model: pet) do |f| %>
  <%= render "shared/error_messages", object: f.object %>
  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :species, class: "form-label" %>
    <%= f.text_field :species, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :weight, class: "form-label" %>
    <%= f.number_field :weight, step: 0.1, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :owner_id, "Owner", class: "form-label" %>
    <%= f.collection_select :owner_id, Owner.all, :id, :last_name, 
        { prompt: "Select Owner" }, { class: "form-select" } %>
  </div>
  
  <div class="mb-3">
    <%= f.label :photo, "Foto de la mascota", class: "form-label" %>
  
    <% if pet.photo.attached? && pet.persisted? %>
      <div class="mb-2">
        <p class="small text-muted">Foto actual:</p>
        <%= image_tag pet.photo.variant(resize_to_limit: [100, 100]), class: "img-thumbnail d-block" %>
      </div>
    <% end %>

    <%= f.file_field :photo, class: "form-control" %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>