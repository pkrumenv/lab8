<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Owners</h1>
  <%= link_to 'New Owner', new_owner_path, class: "btn btn-primary" %>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th class="text-center">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @owners.each do |owner| %>
        <tr>
          <td><%= owner.first_name %> <%= owner.last_name %></td>
          <td><%= owner.email %></td>
          <td><%= owner.phone %></td>
          <td class="text-center">
            <div class="d-flex justify-content-center gap-2">
              <%= link_to 'Show', owner, class: "btn btn-sm btn-info" %>
              <%= link_to 'Edit', edit_owner_path(owner), class: "btn btn-sm btn-warning" %>
              <%= button_to 'Delete', owner, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>