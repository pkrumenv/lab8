<div class="card mb-4 shadow-sm">
  <div class="card-header bg-primary text-white">
    <h2 class="mb-0">Owner Details</h2>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <p><strong>Full Name:</strong> <%= @owner.name %></p>
        <p><strong>Email:</strong> <%= @owner.email %></p>
      </div>
      <div class="col-md-6">
        <p><strong>Phone:</strong> <%= @owner.phone %></p>
        <p><strong>Address:</strong> <%= @owner.address %></p>
      </div>
    </div>
  </div>
</div>

<h3 class="mb-3">Registered Pets</h3>
<div class="list-group shadow-sm">
  <% @owner.pets.each do |pet| %>
    <%= link_to pet_path(pet), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
      <div>
        <strong><%= pet.name %></strong> - <%= pet.species %> (<%= pet.breed %>)
      </div>
      <span class="btn btn-sm btn-outline-secondary">View Pet</span>
    <% end %>
  <% end %>
</div>

<%= link_to 'Back to Owners', owners_path, class: "btn btn-secondary mt-4" %>