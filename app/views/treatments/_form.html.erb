<%= form_with(model: [@appointment, treatment]) do |f| %>
  <%= render "shared/error_messages", object: f.object %>

  <div class="mb-3">
    <%= f.label :notes, class: "form-label" %>
    <%= f.text_area :notes, class: "form-control", rows: 4 %>
  </div>

  <div class="mb-3">
    <%= f.label :administered_at, class: "form-label" %>
    <%= f.datetime_field :administered_at, class: "form-control" %>
  </div>

  <div class="mt-4">
    <%= f.submit "Save Treatment", class: "btn btn-success" %>
  </div>
<% end %>