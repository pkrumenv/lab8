<%= form_with(model: appointment) do |f| %>
  <div class="mb-3">
    <%= f.label :pet_id, class: "form-label" %>
    <%= f.collection_select :pet_id, Pet.all, :id, :name, {}, {class: "form-select"} %>
  </div>
  <div class="mb-3">
    <%= f.label :appointment_date, class: "form-label" %>
    <%= f.datetime_field :appointment_date, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :status, class: "form-label" %>
    <%= f.select :status, Appointment.statuses.keys.map { |s| [s.humanize, s] }, 
        {}, { class: "form-select" } %>
  </div>
  <%= f.submit class: "btn btn-primary" %>
<% end %>