<div class="mb-4">
  <h1>Veterinarians</h1>
</div>

<table class="table table-striped table-hover shadow-sm">
  <thead class="table-dark">
    <tr>
      <th>Full Name</th>
      <th>Email</th>
      <th>Specialization</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @vets.each do |vet| %>
      <tr>
        <td><%= link_to vet.name, vet_path(vet), class: "text-decoration-none fw-bold" %></td>
        <td><%= vet.email %></td>
        <td><span class="badge bg-info text-dark"><%= vet.specialization %></span></td>
        <td>
          <%= link_to "View Details", vet_path(vet), class: "btn btn-sm btn-outline-primary" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>